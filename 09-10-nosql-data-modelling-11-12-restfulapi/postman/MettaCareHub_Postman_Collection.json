            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Randi\",\n  \"phone\": \"081299998888\",\n  \"serviceId\": 1,\n  \"vehicleNumber\": \"BG 1234 AB\",\n  \"bookingDate\": \"2026-10-20 14:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains created booking data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('bookingId');",
                  "    pm.expect(jsonData.data.customerName).to.eql('Randi');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
